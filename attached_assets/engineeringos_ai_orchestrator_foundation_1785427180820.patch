+import type { PromptContextProfile } from "./prompt-composer.js";
+import type { QualityProfile } from "../quality-engine.js";
+
+/**
+ * Central prompt-routing policy for AI orchestrator tasks.
+ *
+ * The goal is to keep prompt section selection consistent with the task
+ * quality profile so future agents do not drift into ad-hoc context choices.
+ */
+export function resolvePromptContextProfile(profile: QualityProfile): PromptContextProfile {
+  switch (profile) {
+    case "analysis":
+      return "scan";
+    case "task_execution":
+      return "task";
+    case "code_review":
+      return "review";
+    case "workflow":
+      return "workflow";
+    case "tool_chat":
+    case "chat":
+    default:
+      return "chat";
+  }
+}

