+import type { AgentCompleteOpts } from "../agent-complete.js";
+import type { ProviderCapabilityHints } from "../provider-capabilities.js";
+import { buildQualityPlan, type QualityProfile } from "../quality-engine.js";
+import { buildTaskProfile, type TaskProfile } from "./task-profile.js";
+
+export type ExecutionPlan = {
+  taskProfile: TaskProfile;
+  qualityProfile: QualityProfile;
+  strictHints: ProviderCapabilityHints;
+  relaxedHints: ProviderCapabilityHints;
+  retryBudget: number;
+};
+
+export function buildExecutionPlan(
+  scope: string,
+  opts?: AgentCompleteOpts & { hasTools?: boolean },
+): ExecutionPlan {
+  const taskProfile = buildTaskProfile(scope, opts);
+  const qualityPlan = buildQualityPlan(taskProfile.qualityProfile, { requireTools: taskProfile.hasTools });
+
+  return {
+    taskProfile,
+    qualityProfile: taskProfile.qualityProfile,
+    strictHints: opts?.qualityHints ?? qualityPlan.strictHints,
+    relaxedHints: opts?.qualityHints ?? qualityPlan.relaxedHints,
+    retryBudget: taskProfile.retryBudget,
+  };
+}

