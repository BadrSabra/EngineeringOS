+import type { AgentErrorCode } from "../errors.js";
+import type { QualityAssessment } from "../quality-engine.js";
+import type { ProviderCapabilityHints } from "../provider-capabilities.js";
+import type { ExecutionPlan } from "./quality-planner.js";
+
+export type RetryAttempt = {
+  attempt: number;
+  maxAttempts: number;
+};
+
+export function selectAttemptHints(plan: ExecutionPlan, attempt: number): ProviderCapabilityHints {
+  return attempt <= 0 ? plan.strictHints : plan.relaxedHints;
+}
+
+export function canRetryAttempt(plan: ExecutionPlan, attempt: number): boolean {
+  return attempt < plan.retryBudget;
+}
+
+export function shouldRetryParseFailure(_code: AgentErrorCode): boolean {
+  // Parse/validation failures are the exact cases where a fresh model pass
+  // has the highest chance of recovering a valid structured payload.
+  return true;
+}
+
+export function shouldRetryAssessment(
+  assessment: QualityAssessment | undefined,
+  plan: ExecutionPlan,
+  attempt: number,
+  hasExplicitHints: boolean,
+): boolean {
+  if (!assessment) return false;
+  if (assessment.decision !== "retry") return false;
+  if (hasExplicitHints) return false;
+  return canRetryAttempt(plan, attempt);
+}
