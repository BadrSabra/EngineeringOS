+import type { QualityProfile } from "../quality-engine.js";
+import { resolvePromptContextProfile } from "../prompts/prompt-planner.js";
+import type { PromptContextProfile } from "../prompts/prompt-composer.js";
+
+export type TaskType = QualityProfile;
+
+export type TaskComplexity = "low" | "medium" | "high";
+
+export type TaskProfile = {
+  taskType: TaskType;
+  qualityProfile: QualityProfile;
+  promptProfile: PromptContextProfile;
+  complexity: TaskComplexity;
+  hasTools: boolean;
+  retryBudget: number;
+};
+
+const QUALITY_PROFILE_BY_SCOPE: Record<string, QualityProfile> = {
+  "task-agent": "task_execution",
+  "scan-analyst": "analysis",
+  "code-reviewer": "code_review",
+  "workflow-orchestrator": "workflow",
+};
+
+function resolveQualityProfile(scope: string, override?: QualityProfile): QualityProfile {
+  return override ?? QUALITY_PROFILE_BY_SCOPE[scope] ?? "chat";
+}
+
+function resolveComplexity(profile: QualityProfile): TaskComplexity {
+  switch (profile) {
+    case "analysis":
+    case "code_review":
+      return "high";
+    case "task_execution":
+    case "workflow":
+      return "medium";
+    case "tool_chat":
+    case "chat":
+    default:
+      return "low";
+  }
+}
+
+function resolveRetryBudget(complexity: TaskComplexity): number {
+  switch (complexity) {
+    case "high":
+      return 2;
+    case "medium":
+      return 1;
+    case "low":
+    default:
+      return 1;
+  }
+}
+
+export function buildTaskProfile(
+  scope: string,
+  opts?: { qualityProfile?: QualityProfile; hasTools?: boolean },
+): TaskProfile {
+  const qualityProfile = resolveQualityProfile(scope, opts?.qualityProfile);
+  const taskType = qualityProfile;
+  const complexity = resolveComplexity(qualityProfile);
+  const hasTools = opts?.hasTools ?? false;
+
+  return {
+    taskType,
+    qualityProfile,
+    promptProfile: resolvePromptContextProfile(qualityProfile),
+    complexity,
+    hasTools,
+    retryBudget: resolveRetryBudget(complexity),
+  };
+}
+
+export function classifyTaskType(
+  scope: string,
+  opts?: { qualityProfile?: QualityProfile; hasTools?: boolean },
+): TaskType {
+  return buildTaskProfile(scope, opts).taskType;
+}

