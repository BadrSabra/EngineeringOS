--- EngineeringOS-main/lib/ai-orchestrator/src/prompts/prompt-composer.ts	1970-01-01 00:00:00.000000000 +0000
+++ EngineeringOS-main/lib/ai-orchestrator/src/prompts/prompt-composer.ts	2026-07-26 03:49:32.095660032 +0000
@@ -0,0 +1,30 @@
+import type { ProjectContext } from "../context-builder.js";
+
+export function composePrompt(...parts: Array<string | null | undefined | false>): string {
+  return parts
+    .filter((part): part is string => typeof part === "string" && part.trim().length > 0)
+    .join("\n\n");
+}
+
+export function promptSection(title: string, body: string): string {
+  return `**${title}:**\n${body}`;
+}
+
+export function promptCodeBlock(content: string, language = "text"): string {
+  return `\`\`\`${language}\n${content}\n\`\`\``;
+}
+
+export function promptList(items: string[], indent = ""): string {
+  return items.map((item) => `${indent}- ${item}`).join("\n");
+}
+
+export function promptContextOverview(context: ProjectContext): string {
+  return composePrompt(
+    promptSection("Project", context.project),
+    promptSection("Quality Metrics", context.latestMetrics),
+    promptSection("Knowledge Graph", context.graphSummary),
+    promptSection("Workflows", context.workflows),
+    promptSection("Recent Tasks", context.recentTasks),
+    promptSection("Recent Events", context.recentEvents),
+  );
+}
