{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "schema:apply": "drizzle-kit push --config ./drizzle.config.ts && tsx ./src/apply-mission-outcome-snapshot-immutability.ts && tsx ./src/check-schema.ts",
    "schema:apply:post-merge": "tsx ./src/assert-safe-post-merge-push.ts && pnpm run push-force && tsx ./src/apply-mission-outcome-snapshot-immutability.ts && tsx ./src/check-schema.ts",
    "schema:canary": "tsx ./src/legacy-memory-schema-upgrade.ts",
    "schema:check": "tsx ./src/check-schema.ts",
    "check-audit-schema": "tsx ./src/check-audit-schema.ts",
    "check-operator-alert-schema": "tsx ./src/check-operator-alert-schema.ts",
    "test": "tsx --test ./src/audit-schema-check.test.ts ./src/application-schema-check.test.ts ./src/schema-push-guard.test.ts ./src/schema/preview-agent-nodes.test.ts ./src/schema/preview-build-jobs.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "catalog:"
  }
}
