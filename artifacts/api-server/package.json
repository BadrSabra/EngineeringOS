{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && node ./scripts/stop-old-api.mjs && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck:dependencies": "tsc --build --force ../../lib/db ../../lib/api-zod ../../lib/api-client-react ../../lib/scanner ../../lib/knowledge-engine ../../lib/ai-orchestrator",
    "typecheck": "pnpm run typecheck:dependencies && tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test scripts/stop-old-api.test.mjs scripts/release-lock.test.mjs",
    "test:discovery-release": "DISCOVERY_RELEASE_RECEIPT_PATH=../../test-results/discovery/release-receipt.json vitest run src/routes/discovery.test.ts",
    "test:release-fixture-collisions": "node ./scripts/run-release-fixture-collision-check.mjs",
    "test:release-synthesis-telemetry": "node ./scripts/run-release-ai-stream.mjs && node ./scripts/run-release-synthesis-telemetry.mjs",
    "test:process-recovery": "node ./scripts/run-real-process-recovery.mjs",
    "test:live-empty-model-response": "node ./scripts/run-live-empty-model-response.mjs",
    "validate:live-provider-review": "node ./scripts/run-live-provider-review-campaign.mjs",
    "validate:empirical-quality": "node ./scripts/run-empirical-quality-campaign.mjs",
    "validate:empirical-quality-corpus": "node ./scripts/run-empirical-quality-corpus.mjs",
    "smoke:openrouter-free": "tsx ./scripts/run-live-openrouter-free-smoke.mjs",
    "benchmark:live": "tsx src/lib/run-code-agent-benchmark.ts",
    "benchmark:airlock": "tsx src/lib/run-code-agent-benchmark-airlock.ts",
    "benchmark:coverage": "BENCHMARK_CAMPAIGN_MODE=coverage tsx src/lib/run-code-agent-benchmark-airlock.ts",
    "benchmark:recovery": "BENCHMARK_CAMPAIGN_MODE=clean-witness BENCHMARK_RECOVERY_ONLY=true tsx src/lib/run-code-agent-benchmark-airlock.ts",
    "benchmark:witness": "BENCHMARK_CAMPAIGN_MODE=clean-witness tsx src/lib/run-code-agent-benchmark-airlock.ts",
    "benchmark:canary": "tsx src/lib/run-code-agent-benchmark-airlock.ts",
    "benchmark:approve-baseline": "tsx src/lib/approve-code-agent-baseline.ts",
    "benchmark:release-gate": "tsx src/lib/benchmark-release-gate.ts",
    "validate:ai-release": "tsx src/lib/ai-release-quality-gate.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.39",
    "@clerk/shared": "^4.25.2",
    "@workspace/ai-orchestrator": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/knowledge-engine": "workspace:*",
    "@workspace/scanner": "workspace:*",
    "adm-zip": "^0.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "http-proxy-middleware": "^4.2.0",
    "multer": "^2.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
