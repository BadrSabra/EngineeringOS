+const PATH_INPUT_KEYS = new Set(["path", "paths", "target", "targetpath", "targetpaths"]);
+const SENSITIVE_PATH = /^(?:\.env(?:\..*)?|\.git(?:\/|$)|\.ssh(?:\/|$)|(?:secrets?|credentials?)(?:[._-]|\/|$)|.*(?:private[_-]?key|password|token|api[_-]?key).*)$/i;
