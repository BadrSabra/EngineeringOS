modules = ["nodejs-20", "web", "python-3.12"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "run", "deployment:post-build"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/dashboard: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/mockup-sandbox: Component Preview Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dashboard-restart-smoke"


[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "artifacts/dashboard: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=23183 BASE_PATH=/dashboard/ pnpm --filter @workspace/dashboard run dev"
waitForPort = 23183

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8081 BASE_PATH=/__mockup pnpm --filter @workspace/mockup-sandbox run dev"
waitForPort = 8081

[[workflows.workflow]]
name = "dashboard-restart-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run validate:dashboard-restart"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "release-process-recovery"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run validate:release"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "release-dashboard-journey"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DASHBOARD_E2E_EXECUTABLE_PATH=$(command -v chromium) pnpm run validate:dashboard-journey"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "atk", "at-spi2-atk", "cups", "dbus", "expat", "fontconfig", "freetype", "libdrm", "libgbm", "libxkbcommon", "libxshmfence", "alsa-lib", "pango", "cairo", "wayland", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXi", "xorg.libXrandr", "xorg.libXrender", "xorg.libXScrnSaver", "xorg.libXtst", "xorg.libxcb", "mesa", "mesa.drivers", "chromium", "ffmpeg"]

[userenv]

[userenv.shared]
AI_CREDENTIALS_ENCRYPTION_KEY = "64cf9fb27c8e994ac689944f2792827d4dfec601c4bf81c88998ea269c7ff684"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 23183
externalPort = 80
